# Hostinger serves this app over Apache/LiteSpeed, which has no idea the
# React app owns routes like /announcements or /admin — those paths don't
# exist as files, so without this the server 404s on any refresh or direct
# link that isn't "/". Every request that doesn't match a real file falls
# through to index.html instead, and react-router-dom takes it from there.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# index.html and the service worker must always be revalidated — they are
# what points the browser at everything else, including which fingerprinted
# JS/CSS files are current. Only /static/ is safe to cache for a year: that is
# where Create React App puts files it names with a content hash
# (main.<hash>.js), so a new build gets a new name rather than overwriting the
# old one. The logos and icons in the public/ root keep their plain filenames,
# so caching those just as hard would mean a swapped logo not showing up for
# returning visitors for a year.
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} ^/static/
  RewriteRule ^ - [E=IS_HASHED_ASSET:1]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set Cache-Control "public, max-age=31536000, immutable" env=IS_HASHED_ASSET
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
