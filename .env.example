REACT_APP_FIREBASE_API_KEY=your_api_key
# Leave this as your_project.firebaseapp.com unless you have done the console
# step below. It is the only handler domain Firebase registers for you.
#
# Why you might want to change it: Firebase finishes a redirect sign-in on this
# domain and then hands the credential to the app. If the app is served from a
# different domain, every browser that partitions third-party storage (Chrome
# on Android included) discards it, and signing in appears to work and then
# silently does nothing. Same-origin is the fix.
#
# Changing it takes TWO lists, which are not the same list:
#
#   1. Firebase Console, Authentication, Settings, Authorized domains.
#      Controls which origins may start a sign-in. your_project.web.app is
#      already here by default.
#
#   2. Google Cloud Console, APIs and Services, Credentials, the OAuth 2.0
#      client named "Web client (auto created by Google Service)", under
#      Authorized redirect URIs. Controls which redirect_uri Google will
#      honour. Only https://your_project.firebaseapp.com/__/auth/handler is
#      registered here automatically.
#
# Setting this to a domain missing from list 2 gets "Error 400:
# redirect_uri_mismatch" on Google's own page, and no sign-in at all. Add
# https://your_domain/__/auth/handler to list 2 first, then change this.
#
# Only Firebase Hosting can serve the /__/auth/ paths, so a custom domain works
# here if it points at Hosting, and cannot if it points at ordinary web hosting.
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# --- Voting security (see SECURITY.md) ---
# reCAPTCHA v3 site key for Firebase App Check. Blocks vote-boosting scripts and
# third-party tools. Leave empty to disable App Check.
REACT_APP_RECAPTCHA_SITE_KEY=

# Optional comma-separated email domains allowed to vote, e.g. psu.edu.ph
# Empty means any Google account may vote.
# NOTE: also uncomment the matching block in firestore.rules to enforce it.
REACT_APP_VOTE_ALLOWED_DOMAINS=
